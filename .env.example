# Supabase (Aster and Co project)
NEXT_PUBLIC_SUPABASE_URL=https://qgzvozurokdjpaketgxz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never exposed to the browser

# Public site URL (used in emailed links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte key, base64. Encrypts per-salon payment credentials at rest.  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Protects cron routes. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Email (Resend). Unset = emails are not sent and stay queued.
RESEND_API_KEY=
EMAIL_FROM=

# SMS (Twilio). Unset = SMS are not sent and stay queued.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Windcave (platform defaults; salons can store their own in Settings > Payments)
WINDCAVE_ENV=uat                      # uat | prod
WINDCAVE_REST_USER=
WINDCAVE_REST_KEY=

# Windcave HIT identifiers agreed with Windcave for your integration
WINDCAVE_DEVICE_ID=
WINDCAVE_POS_NAME=
WINDCAVE_VENDOR_ID=
